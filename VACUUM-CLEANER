# Vacuum Cleaner Problem

room = {
    "A": "Dirty",
    "B": "Dirty"
}

position = "A"

while True:
    print("\nCurrent position:", position)
    print("Room A:", room["A"])
    print("Room B:", room["B"])

    if room[position] == "Dirty":
        print("Action: Clean")
        room[position] = "Clean"

    else:
        if position == "A":
            print("Action: Move to B")
            position = "B"
        else:
            print("Action: Move to A")

            position = "A"

    if room["A"] == "Clean" and room["B"] == "Clean":
        print("\nBoth rooms are clean!")
        break
